# PostgreSQL Database URL
DATABASE_URL=postgres://username:password@localhost/poke_market

# JWT Secret Key
JWT_SECRET=super_secret_jwt_key

# Backend Server Port (defaults to 8080 if not set)
PORT=8080

# Frontend Base URL (Local vs Production)
# - In local development: http://localhost:5173
# - In production: set this to your deployed domain (e.g. https://pokemarket.do or https://your-app.vercel.app)
# This is used to build email verification and password reset links.
BASE_URL=http://localhost:5173

# Optional: Backend URL for uploads when Cloudinary is not configured
# BACKEND_URL=http://localhost:8080

# Resend / SMTP Email Credentials
# If left empty, email sending will output verification and reset links to the console/logs stub
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_FROM=PokéMart <onboarding@resend.dev>

# Optional: Cloudinary URL for image uploads & AWS Rekognition moderation
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
