  "query": "\n        SELECT id, user_id, pokemon_name, series, set_name, condition, price_cents, currency, description, image_url, created_at\n        FROM posts\n        WHERE user_id = $1\n        ORDER BY created_at DESC\n        LIMIT $2 OFFSET $3\n        ",
