{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.id, p.user_id, p.pokemon_name, p.series, p.set_name, p.condition, p.price_cents, p.currency, p.description, p.image_url, p.created_at\n        FROM posts p\n        JOIN favorites f ON p.id = f.post_id\n        WHERE f.user_id = $1\n        ORDER BY f.created_at DESC\n        LIMIT $2 OFFSET $3\n        ",
