  "query": "\n        SELECT c.id, c.post_id, c.user_id, u.username, u.avatar_url, c.content, c.created_at\n        FROM community_comments c\n        JOIN users u ON c.user_id = u.id\n        WHERE c.post_id = $1\n        ORDER BY c.created_at ASC\n        ",
